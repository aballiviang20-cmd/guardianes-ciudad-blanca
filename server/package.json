{
  "name": "guardianes-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "eval": "tsx --env-file-if-exists=.env src/eval/run.ts",
    "eval:score": "tsx src/eval/score.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "minisearch": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
